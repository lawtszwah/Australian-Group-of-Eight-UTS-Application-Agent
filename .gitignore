# 抓取产物与数据集：全部走 data 分支，main 只放代码
# （tests/fixtures/ 里的两个页面快照除外——那是回归测试的基准，属于测试代码）
data/
seeds/
export/
*.db
*.log

# 评估的运行产物：含完整 trace，MB 量级，且可重新跑出来。
# evals/cases.yaml 才是源，它要进版本库。
evals/*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# 环境变量（以后放 ANTHROPIC_API_KEY）
.env

# macOS
.DS_Store
.env.save
.env.*
!.env.example
